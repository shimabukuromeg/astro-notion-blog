---
import * as interfaces from '../../lib/interfaces.ts'
import {
  getAllPosts,
  getPostBySlug,
  getBlock,
  getAllBlocksByBlockId,
  downloadFile,
} from '../../lib/notion/client.ts'
import {
  getPostLink,
  getNavLink,
  getStaticFilePath,
  filePath,
  extractTargetBlocks,
  buildHeadingId,
} from '../../lib/blog-helpers.ts'
import Layout from '../../layouts/Layout.astro'
import PostBody from '../../components/PostBody.astro'
import ArticleHeader from '../../components/primer/ArticleHeader'
import ArticleToc from '../../components/primer/ArticleToc'
import ArticleShare from '../../components/primer/ArticleShare'
import { toListPost, getArticleHeadings } from '../../lib/primer-helpers'


export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post: interfaces.Post) => ({ params: { slug: post.Slug } }))
}

const { slug } = Astro.params

const post = await getPostBySlug(slug)
if (!post) {
  throw new Error(`Post not found. slug: ${slug}`)
}

const [blocks, allPosts] = await Promise.all([
  getAllBlocksByBlockId(post.PageId),
  getAllPosts(),
])

const fileAtacchedBlocks = extractTargetBlocks('image', blocks)
  .concat(extractTargetBlocks('file', blocks))
  .filter((block) => {
    if (!block) {
      return false
    }
    const imageOrFile = block.Image || block.File
    return imageOrFile && imageOrFile.File && imageOrFile.File.Url
  })

// Download files
await Promise.all(
  fileAtacchedBlocks
    .map(async (block) => {
      const expiryTime = (block.Image || block.File).File.ExpiryTime
      if (Date.parse(expiryTime) > Date.now()) {
        return Promise.resolve(block)
      }
      return getBlock(block.Id)
    })
    .map((promise) =>
      promise.then((block) => {
        let url!: URL
        try {
          url = new URL((block.Image || block.File).File.Url)
        } catch (err) {
          console.log('Invalid file URL')
          return Promise.reject()
        }
        return Promise.resolve(url)
      })
    )
    .map((promise) => promise.then(downloadFile))
)

const currentPostIndex = allPosts.findIndex((post) => post.Slug === slug)
const prevPost = allPosts[currentPostIndex + 1]
const nextPost = allPosts[currentPostIndex - 1]

const listPost = toListPost(post)
const articleUrl = new URL(getPostLink(post.Slug), Astro.site).toString()
const firstHeading = blocks[0]?.Heading1
const normalizeTitle = (title: string) => title.normalize('NFKC').replace(/\s+/g, '')
const repeatsTitle = firstHeading && !firstHeading.IsToggleable && !firstHeading.Children?.length && normalizeTitle(firstHeading.RichTexts.map(text => text.PlainText).join('')) === normalizeTitle(post.Title)
const articleBlocks = repeatsTitle ? blocks.slice(1) : blocks
const titleHeadingId = repeatsTitle ? buildHeadingId(firstHeading) : undefined
const orderedHeadings = getArticleHeadings(articleBlocks)
const isDev = import.meta.env.DEV
const notionEditUrl = `https://www.notion.so/megumis/${post.PageId.replace(/-/g, '')}`

let ogImage = ''
if (post.FeaturedImage && post.FeaturedImage.Url) {
  ogImage = new URL(filePath(new URL(post.FeaturedImage.Url)), Astro.site)
}
---

<Layout
  title={post.Title}
  description={post.Excerpt}
  path={getPostLink(post.Slug)}
  ogImage={ogImage}
  openGraph={{
    basic: {
      title: post.Title,
      type: 'article',
      image: new URL(getStaticFilePath(`/og/${post.Slug}.png`), Astro.site).toString(),
    },
    image: { alt: post.Title },
  }}
>

  <div slot="main" class="article-grid">
    <article class="article-content">
      <ArticleHeader {...listPost} articleUrl={articleUrl} headingId={titleHeadingId} homeHref={getNavLink('/')} editHref={isDev ? notionEditUrl : undefined} />
      {orderedHeadings.length > 0 && <details class="mobile-toc"><summary>この記事の内容</summary><ArticleToc headings={orderedHeadings} /></details>}
      <PostBody blocks={articleBlocks} />
      <div class="article-share-footer">
        <p>この記事をシェア</p>
        <ArticleShare title={post.Title} url={articleUrl} />
      </div>
      <nav class="article-pagination" aria-label="前後の記事">
        {prevPost && <a href={getPostLink(prevPost.Slug)}><span>← 前の記事</span>{prevPost.Title}</a>}
        {nextPost && <a href={getPostLink(nextPost.Slug)}><span>次の記事 →</span>{nextPost.Title}</a>}
      </nav>
    </article>
    {orderedHeadings.length > 0 && <aside class="toc-container"><ArticleToc headings={orderedHeadings} client:load /></aside>}
  </div>
</Layout>
