---
import type { Post } from '../lib/interfaces'
import { getAllPosts } from '../lib/notion/client'
import { getNavLink } from '../lib/blog-helpers'
import { getEditorialImage } from '../lib/editorial-image'
import { toListPost, pageLinks } from '../lib/primer-helpers'
import PostList from './primer/PostList'
import { getTaxonomyLink, matchesTaxonomy, taxonomyLabels, type TaxonomyKind } from '../lib/taxonomy'

interface Props {
  posts: Post[]
  currentPage: number
  numberOfPages: number
  tag?: string
  taxonomy?: TaxonomyKind
}
const { posts, currentPage, numberOfPages, tag = '', taxonomy } = Astro.props
const allPosts = await getAllPosts()
const total = tag ? allPosts.filter(post => taxonomy ? matchesTaxonomy(post, taxonomy, tag) : post.Tags.some(t => t.name === tag)).length : allPosts.length
const topics = [
  { name: '本の感想', kind: 'category' as const, label: '本の感想', shortLabel: '本の感想' },
  { name: '組織・マネジメント', kind: 'category' as const, label: '組織とマネジメント', shortLabel: '組織づくり' },
  { name: '日記', kind: 'category' as const, label: '日記', shortLabel: '日記' },
].map(topic => ({...topic, href: getTaxonomyLink(topic.kind, topic.name), count: allPosts.filter(post => matchesTaxonomy(post, topic.kind, topic.name)).length})).filter(topic => topic.count > 0)
// Reuse book covers and the first body image in diaries for the home feed.
// Explicit FeaturedImage always wins; only the seven latest stories need it.
const listPosts = await Promise.all(posts.map(async (post, index) => {
  const item = toListPost(post)
  if (tag || currentPage !== 1 || index >= 7 || item.image) return item
  const image = await getEditorialImage(post)
  return { ...item, image: image?.src }
}))
---

<PostList
  posts={listPosts}
  total={total}
  topics={topics}
  tag={tag}
  kindLabel={tag ? taxonomy ? taxonomyLabels[taxonomy] : '旧タグ' : undefined}
  homeHref={getNavLink('/')}
  currentPage={currentPage}
  pageLinks={taxonomy ? Array.from({ length: numberOfPages }, (_, index) => getTaxonomyLink(taxonomy, tag, index + 1)) : pageLinks(numberOfPages, tag)}
/>
