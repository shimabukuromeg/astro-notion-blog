---
import { SEO } from 'astro-seo';
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants.ts'
import { getDatabase, getAllTags, getAllPosts } from '../lib/notion/client.ts'
import { getNavLink, getStaticFilePath, getTagLink } from '../lib/blog-helpers.ts'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import PrimerShell from '../components/primer/PrimerShell'
import { toListPost } from '../lib/primer-helpers'
import '../styles/primer-blog.css'
import '../styles/notion-color.css'

export interface Props {
  currentTag?: string
  title: string
  description: string
  path: string
  ogImage: string
	openGraph: OpenGraph
}

export type OpenGraph = {
  basic: {
    title: string;
    type: 'article' | 'website';
    image: string;
  };
  image: {
    alt: string;
  };
};

const database = await getDatabase()
const tags = await getAllTags()
const allPosts = await getAllPosts()

const {
  currentTag = '',
  title = '',
  description = '',
  path = '/',
  openGraph,
} = Astro.props;

const siteTitle = title ? `${title} - ${database.Title}` : database.Title
const profileImageSrc = getStaticFilePath('/favicon.ico')
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/og.png'),
  Astro.site
)
---

<!DOCTYPE html>
<html lang="ja" data-color-mode="light" data-light-theme="light" data-dark-theme="dark" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      try {
        const preference = localStorage.getItem('blog-color-mode');
        document.documentElement.dataset.colorMode = preference === 'dark' || (!preference && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      } catch { /* Use the server-rendered light theme when storage is unavailable. */ }
    </script>
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={profileImageSrc} type="image/jpeg" />
    <meta name="google-site-verification" content="7MyJOp3wAa95XBP7-6eBX7UwA9I-r46zjq0_wIh1SxE" />
    <SEO
      charset="UTF-8"
      title={siteTitle}
      description={siteDescription}
      canonical={siteURL}
      openGraph={openGraph || {
        basic: {
          title: `${siteTitle}`,
          type: "website",
          image: `${siteOGImage}`,
        }
      }}
      twitter={openGraph ? {
        card: 'summary_large_image',
        title: openGraph.basic.title,
        image: openGraph.basic.image,
      } : {
        card: 'summary_large_image',
      }}
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <PrimerShell
      title={database.Title}
      profileImageSrc={profileImageSrc}
      description={database.Description}
      homeHref={getNavLink('/')}
      feedHref={getNavLink('/feed')}
      currentTag={currentTag}
      isIndex={!path.startsWith('/posts/') || path.startsWith('/posts/page/') || path.startsWith('/posts/tag/')}
      tags={tags.map(tag => ({name: tag.name, href: getTagLink(tag.name), count: allPosts.filter(post => post.Tags.some(t => t.name === tag.name)).length})).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'ja'))}
      posts={allPosts.map(post => ({...toListPost(post), tags: post.Tags.map(tag => tag.name)}))}
      client:load
    >
      <slot name="main" />
    </PrimerShell>
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>
