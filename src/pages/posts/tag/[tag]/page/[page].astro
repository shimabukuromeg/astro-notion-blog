---
import type { SelectProperty } from '../../../../../lib/interfaces.ts'
import {
  getPostsByTagAndPage,
  getAllTags,
  getNumberOfPagesByTag,
} from '../../../../../lib/notion/client.ts'
import Layout from '../../../../../layouts/Layout.astro'

export async function getStaticPaths() {
  const allTags = await getAllTags()

  let params = []

  await Promise.all(
    allTags.map((tag: SelectProperty) => {
      return getNumberOfPagesByTag(tag.name).then((numberOfPages: number) => {
        for (let i = 2; i <= numberOfPages; i++) {
          params.push({ params: { tag: tag.name, page: i.toString() } })
        }
      })
    })
  )

  return params
}

const { tag, page } = Astro.params

const [posts, numberOfPages] = await Promise.all([
  getPostsByTagAndPage(tag, parseInt(page, 10)),
  getNumberOfPagesByTag(tag),
])

import PostIndex from '../../../../../components/PostIndex.astro'
---

<Layout title={`${tag}の記事`} currentTag={tag} path={`/posts/tag/${encodeURIComponent(tag)}/page/${page}`}>
  <div slot="main">
    <PostIndex posts={posts} currentPage={parseInt(page, 10)} numberOfPages={numberOfPages} tag={tag} />
  </div>
</Layout>
