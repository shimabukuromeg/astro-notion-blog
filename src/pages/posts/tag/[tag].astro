---
import type { SelectProperty } from '../../../lib/interfaces.ts'
import { NUMBER_OF_POSTS_PER_PAGE } from '../../../server-constants.ts'
import {
  getPostsByTag,
  getAllTags,
  getNumberOfPagesByTag,
} from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import { getStaticFilePath } from '../../../lib/blog-helpers.ts'

export async function getStaticPaths() {
  const allTags = await getAllTags()
  return allTags.map((tag: SelectProperty) => ({ params: { tag: tag.name } }))
}

const { tag } = Astro.params

const [posts, numberOfPages] = await Promise.all([
  getPostsByTag(tag, NUMBER_OF_POSTS_PER_PAGE),
  getNumberOfPagesByTag(tag),
])

import PostIndex from '../../../components/PostIndex.astro'
---

<Layout
  title={`${tag}の記事`}
  currentTag={tag}
  path={`/posts/tag/${encodeURIComponent(tag)}`}
  openGraph={{
    basic: {
      title: `${tag}の記事`,
      type: 'website',
      image: new URL(getStaticFilePath(`/og/category/${encodeURIComponent(tag)}.png`), Astro.site).toString(),
    },
    image: { alt: `${tag}の記事` },
  }}
>
  <div slot="main">
    <PostIndex posts={posts} currentPage={1} numberOfPages={numberOfPages} tag={tag} />
  </div>
</Layout>
